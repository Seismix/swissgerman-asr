# Recordings and anything derived from them. data/ holds a named, identifiable
# person who consented to be interviewed, not to be distributed - see
# data/README.md. Never commit it, and never commit audio from anywhere else
# either: the *.wav/*.m4a/*.mp3 rules are a second line of defence in case a
# file lands outside data/.
data/
out/
cache/
*.wav
*.m4a
*.mp3

# Model weights. Nothing is built locally any more - the ASR model and the ECAPA
# checkpoints are both pulled to ~/.cache/huggingface on first use. models/ is
# where speechbrain used to stage its copy; the *-ct2 rules catch any model
# someone converts by hand, so a 2-3 GB directory can never be committed.
*-ct2/
*-ct2.tmp/
flix-src/
models/

# Environment, built by ./setup.sh
.venv/
.env

# Python
__pycache__/
*.py[cod]
